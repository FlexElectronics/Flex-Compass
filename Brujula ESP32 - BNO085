// ---------------- I2C / sensor ----------------
static bool i2cAck(uint8_t a) {
  Wire.beginTransmission(a);
  return Wire.endTransmission() == 0;
}

// Busca el BNO085 en 0x4A / 0x4B, lo inicia y activa el reporte de vector de rotación.
static bool connectSensor() {
  const uint8_t addrs[2] = {0x4A, 0x4B};
  for (uint8_t i = 0; i < 2; i++) {
    uint8_t a = addrs[i];
    if (!i2cAck(a)) continue;
    if (!bno08x.begin_I2C(a, &Wire)) { Serial.printf("BNO08x responde en 0x%02X pero begin_I2C fallo\n", a); continue; }
    Wire.setClock(I2C_CLOCK_HZ);
    if (!bno08x.enableReport(SH2_ROTATION_VECTOR, REPORT_US)) { Serial.println("enableReport(SH2_ROTATION_VECTOR) fallo"); continue; }
    bnoAddr = a;
    haveSample = false;
    lastSample = millis();
    Serial.printf("BNO08x listo en 0x%02X\n", a);
    return true;
  }
  return false;
}

static void pollSensor() {
  uint32_t now = millis();
  if (state == ST_OK) {
    if (bno08x.wasReset()) {                       // el sensor se reinició: hay que volver a pedir el reporte
      Serial.println("BNO08x se reinicio; reactivando reporte");
      bno08x.enableReport(SH2_ROTATION_VECTOR, REPORT_US);
    }
    for (uint8_t n = 0; n < 8 && bno08x.getSensorEvent(&sv); n++) {
      if (sv.sensorId != SH2_ROTATION_VECTOR) continue;
      float w = sv.un.rotationVector.real, x = sv.un.rotationVector.i;
      float y = sv.un.rotationVector.j,    z = sv.un.rotationVector.k;
      // Eje Y del sensor expresado en el mundo (X=Este, Y=Norte, Z=Arriba)
      float east  = 2.0f * (x * y - w * z);
      float north = 1.0f - 2.0f * (x * x + z * z);
      flatOk = (sqrtf(east * east + north * north) >= MIN_HORIZ);
      if (flatOk) {
        float h = atan2f(east, north) * RAD_TO_DEG + HEADING_OFFSET;
        h = fmodf(h, 360.0f); if (h < 0) h += 360.0f;
        heading = h;
      }
      calLevel  = sv.status & 0x03;                          // exactitud SH-2: 0..3
      accErrDeg = sv.un.rotationVector.accuracy * RAD_TO_DEG; // estimación del propio sensor
      haveSample = true;
      lastSample = now;
    }
    if (now - lastSample > STALE_MS) {
      state = ST_LOST; haveSample = false; lastTry = now;
      Serial.println("BNO08x: sin datos, conexion perdida");
    }
  } else if (now - lastTry >= RETRY_MS) {
    lastTry = now;
    if (connectSensor()) state = ST_OK;
  }
}

// ---------------- HTTP ----------------
static void handleRoot() {
  server.sendHeader("Cache-Control", "no-cache");
  server.send_P(200, "text/html; charset=utf-8", INDEX_HTML);
}

static void handleData() {
  char hb[12], eb[12], out[160];
  const char* s = (state == ST_ABSENT) ? "absent" : (state == ST_LOST) ? "lost" : (haveSample ? "ok" : "wait");
  bool valid = (state == ST_OK && haveSample);
  if (valid && flatOk) snprintf(hb, sizeof hb, "%.1f", heading); else strcpy(hb, "null");
  if (valid && accErrDeg >= 0 && accErrDeg < 360) snprintf(eb, sizeof eb, "%.1f", accErrDeg); else strcpy(eb, "null");
  snprintf(out, sizeof out, "{\"s\":\"%s\",\"h\":%s,\"c\":%d,\"e\":%s,\"age\":%lu,\"addr\":%u}",
           s, hb, valid ? (int)calLevel : -1, eb,
           valid ? (unsigned long)(millis() - lastSample) : 0UL, (unsigned)bnoAddr);
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", out);
}

void setup() {
  Serial.begin(115200);
  delay(300);
  Serial.println("\nFleX Compass");

  Wire.begin(SDA_PIN, SCL_PIN);
  delay(200);                                  // el BNO085 tarda un poco en arrancar
  if (connectSensor()) state = ST_OK;
  else Serial.println("BNO085 no detectado (se reintentara)");
  lastTry = millis();

  WiFi.mode(WIFI_AP);
  WiFi.setSleep(false);
  WiFi.softAP(AP_SSID, AP_PASS, 1, 0, 2);      // canal 1, visible, máx. 2 clientes
  Serial.print("AP: "); Serial.print(AP_SSID); Serial.print("  IP: "); Serial.println(WiFi.softAPIP());

  server.on("/", HTTP_GET, handleRoot);
  server.on("/api/data", HTTP_GET, handleData);
  server.onNotFound([]() { server.send(404, "text/plain", "404"); });
  server.begin();
}

void loop() {
  server.handleClient();
  pollSensor();
  delay(1);
}
